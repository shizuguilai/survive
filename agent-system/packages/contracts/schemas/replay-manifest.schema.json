{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:survive:replay-manifest:1.0.0",
  "title": "回放元数据，仅供观察者/引擎，不发给角色",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "simCoreVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "engineVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "fixedDtMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "startTick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "endTick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "configHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decisionMode": {
      "type": "string",
      "enum": [
        "real",
        "mock",
        "mixed"
      ]
    },
    "decisionCounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "real": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "mock": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "real",
        "mock"
      ]
    },
    "snapshotFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "eventLogFiles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "complete": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "simCoreVersion",
    "engineVersion",
    "fixedDtMs",
    "startTick",
    "endTick",
    "seed",
    "configHash",
    "decisionMode",
    "decisionCounts",
    "snapshotFiles",
    "eventLogFiles",
    "complete"
  ]
}
